QWidget {
  background-color: #242829;
  color: #dde4e0;
  font-family: "Noto Sans", "DejaVu Sans", sans-serif;
  font-size: 10pt;
}

QMainWindow {
  background-color: #242829;
}

QFrame#metric_card {
  background-color: #303638;
  border: 1px solid #53615c;
  border-radius: 5px;
}

QFrame#temperature_card {
  border: 1px solid #53615c;
  border-radius: 4px;
  background-color: #303638;
}

QLabel#app_title {
  background: transparent;
  color: #dde4e0;
  font-size: 17pt;
  font-weight: 700;
}

QLabel#section_title {
  background: transparent;
  color: #abb8b2;
  font-size: 9pt;
  font-weight: 700;
}

QLabel#metric_caption {
  background: transparent;
  color: #abb8b2;
  font-size: 8pt;
  font-weight: 700;
}

QLabel#cpu_stats_label {
  background: transparent;
  color: #dde4e0;
  font-size: 23pt;
  font-weight: 700;
}

QLabel#load_average_value {
  background: transparent;
  color: #dde4e0;
  font-size: 18pt;
  font-weight: 700;
}

QLCDNumber#clock_qlcd {
  background-color: #1c2021;
  border: 0;
  border-radius: 4px;
  color: #dde4e0;
  padding: 4px 8px;
}

QPushButton {
  min-height: 30px;
  padding: 0 10px;
  border: 1px solid #66756e;
  border-radius: 4px;
  background-color: #394244;
  color: #dde4e0;
  font-weight: 600;
}

QPushButton:hover {
  background-color: #485452;
}

QPushButton#secondary_button, QPushButton#close_button {
  min-height: 52px;
  font-size: 12pt;
}

QPushButton#close_button {
  color: #d9aa9c;
}

QLabel#gpu_temperature {
  min-height: 34px;
  border-radius: 4px;
  background-color: #44392f;
  color: #dbb58e;
  font-size: 16pt;
  font-weight: 700;
}

QLabel#cpu_temperature {
  min-height: 34px;
  border-radius: 4px;
  background-color: #294445;
  color: #9cc9c5;
  font-size: 16pt;
  font-weight: 700;
}

QLabel#temperature_caption {
  background: transparent;
  color: #abb8b2;
  font-size: 8pt;
  font-weight: 700;
}

QLCDNumber {
  background-color: #303638;
  color: #dde4e0;
  border: 1px solid #53615c;
}